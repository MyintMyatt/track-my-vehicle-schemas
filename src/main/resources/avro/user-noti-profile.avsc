{
  "namespace": "dev.orion.noti",
  "type": "record",
  "name": "UserNotiProfile",
  "fields" : [
    {"name" : "username", "type": "string"},
    {"name" : "email", "type": "string"},
    {
      "name" : "phone",
      "type": {
        "type" : "array",
        "items" : "string"
      }
    },
    {"name" : "email_enable", "type": "boolean"},
    {
      "name" : "device_lists",
      "type" : {
        "type" : "array",
        "items" : {
          "type" : "record",
          "name" : "DeviceInfo",
          "doc" : "Individula item details inside device list",
          "fields" : [
            {"name" : "device_name", "type": "string"},
            {"name" : "device_id", "type": "string"},
            {"name" : "fcm_token", "type": "string"},
            {"name" : "push_enable", "type": "boolean"},
            {"name" : "sms_enable", "type": "boolean"}     
          ]
        }
      }
    }
  ]
}
